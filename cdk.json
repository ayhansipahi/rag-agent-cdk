{
  "app": "npx ts-node --prefer-ts-exts bin/rag-agent.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules",
      "docs-sample/**"
    ]
  },
  "context": {
    "basename": "rag-assistant",
    "agentModelId": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "embeddingModelId": "amazon.titan-embed-text-v2:0",
    "embeddingDimension": 1024,
    "retrievalNumResults": 5,
    "agentInstruction": "You are a helpful RAG assistant. Answer the user's question using only the information returned by the knowledge base. If the answer is not in the knowledge base, say so plainly. Include short citations when you quote retrieved content.",
    "enableGuardrail": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ec2:launchTemplateDefaultUserData": true,
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/core:newStyleStackSynthesis": true
  }
}
